# 必須: Claude API キー
ANTHROPIC_API_KEY=
# 必須（serve）: 管理画面のパスワード（12文字以上。長いランダム文字列を推奨）
ADMIN_PASSWORD=
# 推奨: Slack Incoming Webhook（受注・要対応・停止の通知）
SLACK_WEBHOOK_URL=
# 任意: セッション切れ時の自動再ログイン用
CW_EMAIL=
CW_PASSWORD=
# HTTPS 公開時（docker compose --profile https）は 1 にする
COOKIE_SECURE=0
TRUST_PROXY=0
# 任意: HTTPS で公開するドメイン（DNS の A レコードをサーバーの IP に向けてから）
DOMAIN=
