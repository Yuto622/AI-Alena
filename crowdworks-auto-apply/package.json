{
  "name": "crowdworks-auto-apply",
  "version": "1.0.0",
  "private": true,
  "description": "CrowdWorks の案件検索 → AI 審査 → 自動応募 → メッセージ対応 → 契約承諾までを安全装置付きで自動化するボット",
  "type": "module",
  "bin": {
    "cw-apply": "src/cli.js"
  },
  "scripts": {
    "login": "node src/cli.js login",
    "run": "node src/cli.js run",
    "dry-run": "node src/cli.js run --dry-run",
    "loop": "node src/cli.js loop",
    "stats": "node src/cli.js stats",
    "apply": "node src/cli.js apply",
    "test": "node --test test/*.test.js",
    "inbox": "node src/cli.js inbox",
    "resume": "node src/cli.js resume",
    "stop": "node src/cli.js stop",
    "unhalt": "node src/cli.js unhalt"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "playwright": "1.63.0",
    "zod": "^3.25.0"
  }
}
